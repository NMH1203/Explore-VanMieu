# EXAMPLE FILE - use placeholder values only; do not put secrets in this file.
# The backend does not automatically load .env.example.
# Copy the backend variables below into .env in the project root,
# fill in the actual values in .env, then restart the backend.
# Back up your existing configuration before overwriting an active .env file.

# Authentication: replace with a long random secret unique to each environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# AI: put your actual API key in .env; do not commit the key to Git.
YESCALE_API_KEY=replace_with_your_api_key
YESCALE_BASE_URL=https://api.yescale.io/v1
YESCALE_VISION_MODEL=gpt-4o-mini
YESCALE_CHAT_MODEL=gpt-4o-mini
YESCALE_MIN_CONFIDENCE=0.70

# Database: leave this setting commented out to use the default
# database/explore_van_mieu.db, resolved by the backend relative to the project root.
# Uncomment only to change the database. An absolute path is recommended.
# DATABASE_URL=sqlite:///D:/path/to/Explore-VanMieu/database/explore_van_mieu.db

# Camera test: disabled by default. The backend also reads these variables from .env.camera-test.
# Configure them in ONE file (.env OR .env.camera-test) to avoid duplicate values.
# Use the user_id from the database, NOT a username or email.
CAMERA_TEST_ENABLED=false
CAMERA_TEST_USER_ID=

# Vite proxy: vite.config.js currently reads process.env directly.
# Set these in a PowerShell terminal before running npm run dev (copying into .env is not enough):
# $env:VITE_API_TARGET = 'http://127.0.0.1:8000'
# $env:VITE_API_TLS_INSECURE = 'false'
# Use true only when proxying to a local HTTPS backend with a self-signed certificate.
