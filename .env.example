# FILE MAU - chi dung gia tri minh hoa, khong dien bi mat vao file nay.
# Backend khong tu doc ten .env.example.
# Sao chep cac bien backend ben duoi vao .env tai thu muc goc du an,
# dien gia tri that trong .env, sau do khoi dong lai backend.
# Khong ghi de .env dang su dung neu chua sao luu cau hinh cu.

# Xac thuc: thay bang chuoi ngau nhien dai, rieng cho moi moi truong.
JWT_SECRET_KEY=replace_with_a_long_random_secret

# AI: dien API key that trong .env, khong commit key len Git.
YESCALE_API_KEY=replace_with_your_api_key
YESCALE_BASE_URL=https://api.yescale.io/v1
YESCALE_VISION_MODEL=gpt-4o-mini
YESCALE_CHAT_MODEL=gpt-4o-mini
YESCALE_MIN_CONFIDENCE=0.70

# Database: bo trong phan cau hinh nay de dung mac dinh
# database/explore_van_mieu.db, duoc backend tinh theo thu muc du an.
# Chi bo dau # neu can doi database. Duong dan tuyet doi duoc khuyen dung.
# DATABASE_URL=sqlite:///D:/path/to/Explore-VanMieu/database/explore_van_mieu.db

# Camera test: mac dinh tat. Backend cung doc hai bien nay tu .env.camera-test.
# Chi cau hinh o MOT file (.env HOAC .env.camera-test) de tranh gia tri trung lap.
# Dung user_id trong database, KHONG dung username hay email.
CAMERA_TEST_ENABLED=false
CAMERA_TEST_USER_ID=

# Vite proxy: hien tai vite.config.js doc truc tiep process.env.
# Dat trong terminal PowerShell truoc khi chay npm run dev (khong chi copy vao .env):
# $env:VITE_API_TARGET = 'http://127.0.0.1:8000'
# $env:VITE_API_TLS_INSECURE = 'false'
# Chi dung true khi proxy toi backend HTTPS voi chung chi tu ky cuc bo.
