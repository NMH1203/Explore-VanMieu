# Sao chep thanh .env tai thu muc goc du an. Khong commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=database/vanmieu.sqlite
AUTO_SEED=true
SESSION_HOURS=24
GPS_MAX_ACCURACY_METERS=50
GPS_MAX_AGE_SECONDS=120
# Chi dung boi npm run admin:create. Dien gia tri cua ban.
ADMIN_EMAIL=
ADMIN_NAME=Quan tri vien
ADMIN_PASSWORD=
